{
  "manifest_version": 3,
  "name": "WordLens",
  "version": "1.1",
  "description": "Shows the meaning of any selected word on a webpage.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "https://translate.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["style.css"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle WordLens"
  }
}
